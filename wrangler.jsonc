{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appppp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "88a6f667-7565-4e51-91d3-38f2163ee725","database_name": "web-apppp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bf0e2390252a408faf41dd36be38a7a4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
